<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="es.azkarmudanzas.widgets"
    android:versionCode="18"
    android:versionName="1.17">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v1.17: para que Azkarin sepa DESDE DONDE sales y pueda decir cuanto tardas.
         Solo se lee con la tarjeta del walkie-talkie abierta; al cerrarla se suelta. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Para poder encontrar la app de Azkar instalada y abrirla desde los widgets.
         v1.15: y para poder LLAMAR con Zoiper (o con el marcador de siempre si no está)
         y escribir correos desde el botón de cada raya del repaso. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <package android:name="com.zoiper.android.app" />
    </queries>

    <application
        android:label="Azkar Widgets"
        android:icon="@drawable/azkarin"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Azkar Widgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v1.16: el plan de trabajo (el portal de los chicos) tiene un botón
                 "PONER EL PANEL EN LA TABLET". Ese botón abre ESTA pantalla con el enlace
                 ya dentro (azkarwidget://equipo?u=…), para que nadie tenga que copiar a
                 mano un código largo — que es justo donde se equivoca todo el mundo.
                 Si la app no estuviera instalada, el navegador se baja la APK él solo
                 (browser_fallback_url). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="azkarwidget" android:host="equipo" />
            </intent-filter>
        </activity>

        <!-- v1.2: hablar con Azkarin DIRECTO desde la burbuja — tarjetita flotante,
             sin navegador y sin abrir la app. Se cierra sola al callarte o al salir. -->
        <activity
            android:name=".VozActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="Azkarin" />

        <!-- v1.15: EL BOTÓN DE CADA COSA. Pantalla que no se ve: recibe el toque del
             botoncito de una raya, abre lo que toca (Zoiper para llamar, el correo, la
             ficha…) y se cierra sola. Si no puede, lo DICE y copia el número: nunca un
             toque muerto. -->
        <activity
            android:name=".AccionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="Azkar" />

        <!-- Widget 1: la burbuja de Azkarin (tócala y habla) -->
        <receiver
            android:name=".WidgetAzkarin"
            android:exported="true"
            android:label="Azkarin — háblale">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_azkarin" />
        </receiver>

        <!-- Widget 2: lo importante de Azkar EN GRANDE -->
        <receiver
            android:name=".WidgetResumen"
            android:exported="true"
            android:label="Azkar — lo de hoy">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="es.azkarmudanzas.widgets.REFRESCAR" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_resumen" />
        </receiver>

        <!-- Widget 3 (v1.14): EL REPASO — lo que quedó colgado, con nombre y teléfono -->
        <receiver
            android:name=".WidgetRepaso"
            android:exported="true"
            android:label="Azkar — repaso (lo pendiente)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="es.azkarmudanzas.widgets.REFRESCAR_REPASO" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_repaso" />
        </receiver>

        <!-- Widget 4 (v1.16): EL TRABAJO DE HOY DEL EQUIPO — EL PANEL GRANDE DE LA TABLET.
             Asier: «que tenga un widget grande, por lo menos que ocupe toda la pantalla,
             para que lo vean bien claro dónde está». Va con EL ENLACE de los chicos, NO
             con el usuario y la clave de Asier: en esa tablet no los hay ni debe haberlos. -->
        <receiver
            android:name=".WidgetEquipo"
            android:exported="true"
            android:label="Azkar — trabajo de hoy (equipo)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="es.azkarmudanzas.widgets.REFRESCAR_EQUIPO" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_equipo" />
        </receiver>

    </application>
</manifest>
