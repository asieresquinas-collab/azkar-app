# Puerto del servidor (por defecto 3000)
PORT=3000
# Carpeta donde se guardan la base de datos y los archivos de los clientes. Debe estar en un disco persistente.
DIR_DATOS=./datos
# Clave de la API de Anthropic: activa la lectura de facturas, el asistente del portal y la redacción de correos.
ANTHROPIC_API_KEY=
# Modelo que se usa (opcional)
# IA_MODELO=claude-opus-5-5
# Envío de correos con Resend (opcional). Sin esto, los avisos solo se ven dentro del portal.
RESEND_API_KEY=
CORREO_REMITENTE="Asesoría <avisos@tudominio.es>"
# Si se define, hay que escribirlo en la pantalla de puesta en marcha (evita que otro cree la cuenta de administrador).
CODIGO_INSTALACION=
